# upstream/ holds read-only reference clones (e.g. Gentleman-Programming/gentle-shell)
# that are not part of this project.
/upstream/
# Spike debug logs, scratch and generated mod types are local, not versioned.
spikes/**/*.log
spikes/**/hook-log.jsonl
spikes/scratch/
spikes/**/.claude-plugin/types/
plugins/odd-claude/.claude-plugin/types/
spikes/**/latest
# odd-claude plugin: local deps and test build output (dist/ IS committed)
plugins/odd-claude/node_modules/
plugins/odd-claude/dist-test/
# odd-claude TUI package: deps, esbuild bundle and test build output
plugins/odd-claude/tui/node_modules/
plugins/odd-claude/tui/dist/
plugins/odd-claude/tui/dist-test/

# Dev-only bench build output (bench/ is not part of the plugin payload)
/bench/dist/

# Python (uv) venv and caches
.venv/
__pycache__/
.pytest_cache/
