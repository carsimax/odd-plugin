{
  "name": "odd-claude-dev",
  "private": true,
  "type": "module",
  "description": "Dev-only tooling of the odd-claude repository (not shipped in the plugin payload).",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:bench": "plugins/odd-claude/node_modules/.bin/tsc -p bench/tsconfig.json",
    "test:bench": "npm run build:bench && node --test bench/dist/*.spec.js bench/dist/*/*.spec.js",
    "bench": "npm run build:bench --silent && node bench/dist/cli.js",
    "eval": "npm run build:bench --silent && node bench/dist/eval/cli.js",
    "bench:hooks": "npm run build:bench --silent && node bench/dist/hookstart.js",
    "test:install": "sh scripts/tests/install.test.sh",
    "check": "npm --prefix plugins/odd-claude run check"
  }
}
