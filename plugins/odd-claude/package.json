{
  "name": "odd-claude",
  "version": "8.1.1",
  "private": true,
  "type": "module",
  "description": "odd-claude plugin for Claude Code",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "clean:test": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\"",
    "test": "npm run clean:test && npm run build && npm run build:test && node --test \"dist-test/**/*.spec.js\"",
    "check": "node scripts/check-naming.mjs",
    "measure": "node scripts/measure.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "5.9.3"
  }
}
